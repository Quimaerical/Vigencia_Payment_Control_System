# Variables exclusivas de `node ace test` (prioridad sobre .env; ADR 0010).
# La suite aborta si DB_DATABASE no termina en _test.
NODE_ENV=test
SESSION_DRIVER=memory
DB_CONNECTION=pg
DB_DATABASE=vigencia_test
# Vacía a propósito: anula una DATABASE_URL de .env para no apuntar nunca a Neon/Railway.
DATABASE_URL=
# Lo usará @adonisjs/limiter (ADR 0004, tarea S02c); hoy no está en start/env.ts.
LIMITER_STORE=memory

# CORS de prueba (ADR 0005 y 0013).
CORS_ALLOWED_ORIGINS=https://vigencia.example.com
CORS_VERCEL_PREVIEW_PREFIX=vigencia-frontend
CORS_VERCEL_TEAM_SLUG=equipo-vigencia
