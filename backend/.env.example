# -----------------------------------------------------------------------------
# Node & Entorno del Servidor
# -----------------------------------------------------------------------------
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# -------------------------------------------------------------
# Configuración de la Aplicación
# -------------------------------------------------------------
LOG_LEVEL=info
APP_KEY=generar_con_node_ace_generate_key
APP_URL=http://${HOST}:${PORT}

# -------------------------------------------------------------
# Driver de Sesión
# -------------------------------------------------------------
SESSION_DRIVER=cookie

# -------------------------------------------------------------
# Base de Datos (PostgreSQL en Docker local)
# -------------------------------------------------------------
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=vigencia_db
DB_SSL=false

# Opcional si se utiliza cadena de conexión unificada:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/vigencia_db

# -------------------------------------------------------------
# Seguridad & CORS
# Orígenes permitidos separados por coma (adicionales a localhost)
# -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app,http://localhost:5173

# Subdominio configurado para el túnel de Cloudflare (sin https://)
TUNNEL_HOSTNAME=api.tudominio.com
