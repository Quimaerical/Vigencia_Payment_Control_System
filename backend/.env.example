# -----------------------------------------------------------------------------
# Node & Entorno del Servidor
# -----------------------------------------------------------------------------
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# -------------------------------------------------------------
# Configuración de la Aplicación
# -------------------------------------------------------------
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# -------------------------------------------------------------
# Driver de Sesión
# -------------------------------------------------------------
SESSION_DRIVER=cookie

# -------------------------------------------------------------
# Base de Datos (PostgreSQL en Docker local)
# -------------------------------------------------------------
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=vigencia_db
DB_SSL=false

# Opcional si se utiliza cadena de conexión unificada:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/vigencia_db

# -------------------------------------------------------------
# Seguridad & CORS (ADR 0005, 0011 y 0013)
# Orígenes exactos permitidos, separados por coma. En producción NO se aceptan localhost.
# Incluye aquí el dominio de producción del frontend.
# -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app

# Previews de Vercel: solo se aceptan si están las dos variables.
# Acepta https://<prefijo>-<lo-que-sea>-<slug>.vercel.app (minúsculas, dígitos y guiones).
# CORS_VERCEL_PREVIEW_PREFIX=tu-proyecto
# CORS_VERCEL_TEAM_SLUG=tu-equipo

# Proxies de confianza para X-Forwarded-For (CSV). Por defecto: loopback (cloudflared).
# En Railway/Render/Fly pon los rangos del balanceador del proveedor.
# TRUSTED_PROXIES=loopback

# Subdominio del túnel de Cloudflare (sin https://); lo usa deploy/, no CORS.
TUNNEL_HOSTNAME=api.tudominio.com

# -------------------------------------------------------------
# Límite de intentos de login (ADR 0004): database (tabla rate_limits) o memory (pruebas)
# -------------------------------------------------------------
LIMITER_STORE=database
