[Unit]
Description=Cloudflare Tunnel for Vigencia Payment Control System API
After=network.target

[Service]
Type=simple
User=sebastian
ExecStart=/usr/bin/cloudflared tunnel --config /home/sebastian/Proyectos/SI/Proyecto\ Vigencia\ Payment\ Control\ System/Vigencia_Payment_Control_System/deploy/cloudflared/config.yml run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
